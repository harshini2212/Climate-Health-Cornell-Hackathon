# Big, rebuildable downloads. data/reference/ IS committed; data/raw/ is not.
# data/truth.json is committed too: it is the world the simulator generates and the model
# is scored against, so it is an input to the build, not an output of it.
data/raw/
data/*.parquet
data/*.nc
# Generated eval output is rebuildable; recorded baselines are the one thing that is not.
# Exclude the contents rather than the directory, or the negation cannot re-include them.
report/*
!report/baselines/

.venv/
*.egg-info/
.pytest_cache/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

node_modules/
ui/dist/
.DS_Store
.env

# Agent worktrees: real git worktrees, never content of this repo.
.claude/worktrees/
